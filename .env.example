# Copy to .env (or export these in the shell). `npm run keys` can create the file for you.
# Never commit real keys. In a GitHub Codespace, store them as Codespaces secrets with the same names.

# Required: four different accounts on Studionet.
# The host needs roughly 0.3 GEN in total, each entrant roughly 0.03 GEN (bonds are paid back).
HOST_KEY=0x
ALICE_KEY=0x
BOB_KEY=0x
CAROL_KEY=0x

# Optional: a fourth entrant (used by the scenarios that need a full round plus one more person).
# Without it a fresh account is funded through the simulator, and those checks are skipped when that fails.
DAVE_KEY=0x

# Optional: a stranger who only sends unpaid calls (a random account is used when empty).
OUTSIDER_KEY=

# Optional: use an existing deployment instead of deploying contracts/matchplay.py first.
MATCHPLAY_ADDRESS=

# Optional tuning
# EVIDENCE_URLS=https://www.iana.org/help/example-domains,https://www.iana.org/domains/reserved,https://example.com/
# REPORT_DIR=reports
